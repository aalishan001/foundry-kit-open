{
 "$schema": "https://opencode.ai/config.json",
 "model": "openrouter/anthropic/claude-haiku-5.5",
 "small_model": "openrouter/anthropic/claude-haiku-5.5",
 "enabled_providers": [
  "openrouter"
 ],
 "share": "disabled",
 "autoupdate": false,
 "provider": {
  "openrouter": {
   "options": {
    "apiKey": "{env:FOUNDRY_OPENROUTER_KEY}"
   },
   "models": {
    "anthropic/claude-haiku-5.5": {
     "options": {
      "provider": {
       "zdr": true,
       "data_collection": "deny",
       "allow_fallbacks": true
      }
     }
    },
    "anthropic/claude-sonnet-5.5": {
     "options": {
      "provider": {
       "zdr": true,
       "data_collection": "deny",
       "allow_fallbacks": true
      }
     }
    }
   }
  }
 },
 "permission": {
  "*": "ask",
  "read": "allow",
  "glob": "allow",
  "grep": "allow",
  "list": "allow",
  "todowrite": "allow",
  "question": "allow",
  "edit": {
   "*": "allow",
   "engine/*": "deny",
   "packs/*": "deny",
   "templates/*": "deny",
   "docs/*": "deny",
   ".claude/*": "deny",
   ".opencode/*": "deny",
   "AGENTS.md": "deny",
   "CLAUDE.md": "deny",
   "opencode.json": "deny",
   "VERSION": "deny",
   "setup.ps1": "deny",
   "setup.cmd": "deny",
   "Gmail setup.cmd": "deny",
   "API keys.cmd": "deny",
   "OpenCode.cmd": "deny"
  },
  "bash": {
   "*": "ask",
   "python engine/*": "allow",
   "py engine/*": "allow",
   "py -3 engine/*": "allow"
  },
  "webfetch": "deny",
  "websearch": "deny",
  "external_directory": "deny",
  "task": {
   "*": "deny",
   "claim-checker": "allow"
  }
 }
}
